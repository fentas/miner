# BTC Miner Configuration
# Copy this file to btcminer.conf and edit as needed

# ============================================
# POOL CONNECTION
# ============================================

# Solo Pool Preset (recommended way to configure)
# Options:
#   ckpool  - solo.ckpool.org (Stratum V1) - 2% fee on block rewards
#   braiins - solo.stratum.braiins.com (Stratum V1) - 0.5% fee on blocks
#   ocean   - mine.ocean.xyz:3334 (Stratum V1 + DATUM) - 0% pool fee
#   custom  - use Pool setting below for custom pool
#
# Using a preset automatically configures Pool and Stratum version
SoloPool = ckpool

# Custom pool address (only used when SoloPool = custom)
# Pool = solo.ckpool.org:3333

# Your Bitcoin address for payouts (REQUIRED)
# Must be a valid Bitcoin address (legacy, P2SH, or bech32)
PayoutAddress = YOUR_BTC_ADDRESS_HERE

# Pool password (optional, default: x)
Password = x

# Stratum protocol version (auto-set by SoloPool, or manual override)
# v1 = JSON-based Stratum (CKPool, Braiins Solo, most pools)
# v2 = Binary Stratum V2 (DMND Pool with SV2 proxy, requires special setup)
# WARNING: Using wrong version for pool will fail to connect!
# NOTE: Both ckpool and braiins presets use Stratum V1
# Stratum = v1

# ============================================
# CPU MINING
# ============================================

# Enable CPU mining (default: true)
# Set to false to use GPU-only mode
EnableCPU = true

# Number of CPU mining threads (0 = auto-detect all cores)
# Only used when EnableCPU = true
Threads = 0

# SIMD optimization level (auto-detected at compile time)
# Options: auto, generic, sha-ni, avx2, avx512
# SimdLevel = auto

# ============================================
# GPU MINING
# ============================================

# Enable GPU mining (requires CUDA or OpenCL build)
# Can be used alongside CPU mining, or exclusively (set EnableCPU = false)
EnableGPU = false

# GPU devices to use (comma-separated, empty = all available)
# GpuDevices = 0,1,2

# GPU intensity (1-100, higher = more GPU utilization)
# GpuIntensity = 80

# ============================================
# WEB INTERFACE
# ============================================

# Web interface port (0 to disable)
WebPort = 8080

# Web files directory
WebDir = web

# ============================================
# IDLE MINING (Screensaver Mode)
# ============================================

# Starts mining when user is idle for this many seconds (0 = disabled)
# Works on native Linux (X11) and WSL2
IdleTimeout = 0

# ============================================
# OUTPUT & LOGGING
# ============================================

# Stats reporting interval in seconds
StatsInterval = 10

# Enable colored console output
Colors = true

# Log file (leave empty to disable file logging)
LogFile = miner.log

# System bell on share found
SystemBell = true

# ============================================
# NETWORK
# ============================================

# Initial delay before reconnecting to pool (seconds)
ReconnectDelay = 5

# Maximum delay between reconnection attempts (seconds)
# Uses exponential backoff up to this limit
MaxReconnectDelay = 300

# ============================================
# BITCOIN CORE INTEGRATION (Advanced)
# ============================================
# For true decentralization with Stratum V2 and custom block templates.
# Requires running your own Bitcoin Core node (can be pruned).

# Enable Bitcoin Core integration (default: false)
# When enabled, miner will create its own block templates for maximum decentralization
BitcoindEnabled = false

# Managed mode: auto download, install, configure, and start/stop Bitcoin Core
# When enabled, btcminer will handle everything automatically:
#   - Downloads Bitcoin Core from bitcoincore.org
#   - Installs to ~/.local/share/bitcoin-core (Linux) or %LOCALAPPDATA%\BitcoinCore (Windows)
#   - Generates bitcoin.conf with optimal settings
#   - Starts bitcoind when mining starts, stops when mining stops
# Set to false if you want to manage Bitcoin Core yourself
BitcoindManaged = false

# Bitcoin Core RPC connection settings
# These must match your bitcoin.conf settings
BitcoindHost = 127.0.0.1
BitcoindRpcPort = 8332
# BitcoindRpcUser = your_rpc_username
# BitcoindRpcPassword = your_rpc_password

# Bitcoin Core data directory (optional, uses default if not set)
# Linux default: ~/.bitcoin
# Windows default: %APPDATA%\Bitcoin
# BitcoindDatadir = /path/to/bitcoin/data

# Pruned node size in MB (default: 10000 = ~10GB)
# Set to 0 for full archival node (requires 600GB+)
# Minimum pruned size is 550 MB
# Recommended: 10000 (keeps recent blocks for reorg protection)
BitcoindPrune = 10000

# Enable Stratum V2 with Bitcoin Core (EXPERIMENTAL)
# Requires Bitcoin Core v30+ compiled with --enable-sv2
# When enabled, uses native SV2 protocol for block template negotiation
BitcoindSv2 = false

# Quick setup for pruned Bitcoin Core node:
# 1. Install Bitcoin Core: https://bitcoin.org/en/download
# 2. Create bitcoin.conf:
#    server=1
#    rpcuser=your_username
#    rpcpassword=your_password
#    prune=10000
# 3. Start bitcoind and wait for initial sync (~10GB download)
# 4. Enable BitcoindEnabled above and set RPC credentials
